{
  "name": "areyouagentic",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for areyouagentic.com",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@areyouagentic/config": "workspace:*",
    "@types/node": "^20.19.43",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "esbuild": "^0.28.1",
      "postcss": "^8.5.23",
      "rollup": ">=3.30.0",
      "sharp": "^0.35.5",
      "undici@7": "^7.30.1",
      "form-data@4": "^4.0.6",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0",
      "find-my-way": "^9.7.0",
      "postcss-selector-parser@6": "^6.1.5",
      "@babel/core": "^7.29.6",
      "fast-copy": "^3.1.0",
      "bullmq>ioredis": "^5.11.1"
    }
  }
}
